# Copy this file to .env and fill in your values.

# OpenRouter API key, used at build time only (never ships to the browser).
# Get one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-...

# Domain to publish to with `make push-surge`, e.g. your-name.surge.sh
# Leave blank to have surge prompt you for one interactively.
SURGE_DOMAIN=
